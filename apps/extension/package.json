{
  "name": "@pluck/extension",
  "description": "The Pluck browser extension: pluck the page you are on, a link, an image or a selection.",
  "repository": { "type": "git", "url": "https://github.com/codu-code/pluck.git", "directory": "apps/extension" },
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit -p ."
  },
  "dependencies": {
    "@pluck/client": "workspace:*",
    "@pluck/i18n": "workspace:*",
    "@pluck/shared-schemas": "workspace:*",
    "@pluck/ui": "workspace:*",
    "geist": "1.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "wxt": "0.21.4"
  }
}
