    "intentLinkDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts the page in your Inbox, as the share sheet does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone la página en tu Bandeja de entrada, como el menú Compartir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe a página na sua Entrada, como o menu Compartilhar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la page dans votre boîte de réception, comme le menu Partager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Seite in deinen Eingang, wie das Teilen-Menü."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有シートと同じように、ページをインボックスに入れます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette la pagina nella tua Inbox, come il menu Condividi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de pagina in je Inbox, net als het deelmenu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 시트처럼 페이지를 수신함에 담아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像共享菜单一样，把网页放进收件箱。"
          }
        }
      }
    },
