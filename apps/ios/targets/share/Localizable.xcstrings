    "queuedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's on your phone. It goes up when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en tu teléfono. Se sube cuando vuelvas a tener conexión."
