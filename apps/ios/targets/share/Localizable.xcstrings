        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È sul tuo telefono. Parte appena torni online."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它先留在你的手机上，联网后就会上传。"
          }
        }
      }
    },
