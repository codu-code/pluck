    "intentNoteDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts a few words in your Inbox as a Note. Links in it become their own Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone unas palabras en tu Bandeja de entrada como Nota. Los enlaces que lleve se vuelven elementos aparte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Põe algumas palavras na sua Entrada como Nota. Os links nela viram Itens próprios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met quelques mots dans votre boîte de réception en Note. Les liens qu’ils contiennent deviennent des éléments à part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt ein paar Worte als Notiz in deinen Eingang. Links darin werden eigene Einträge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い言葉をメモとしてインボックスに入れます。中のリンクはそれぞれ別のアイテムになります。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette qualche parola nella tua Inbox come Nota. I link che contiene diventano elementi a sé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een paar woorden als Notitie in je Inbox. Links erin worden losse items."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 마디를 노트로 수신함에 담아요. 안에 있는 링크는 각각 따로 담겨요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把几句话作为笔记放进收件箱。里面的链接会各自成为条目。"
          }
        }
      }
    },
