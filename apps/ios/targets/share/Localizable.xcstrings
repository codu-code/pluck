    "queuedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's on your phone. It goes up when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en tu teléfono. Se sube cuando vuelvas a tener conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está no seu celular. Sobe quando você estiver online de novo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est sur votre téléphone. Il part dès que vous êtes de nouveau en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist auf deinem iPhone und wird hochgeladen, sobald du wieder online bist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneに残してあります。オンラインに戻ると送られます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È sul tuo telefono. Parte appena torni online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het staat op je telefoon en wordt verstuurd zodra je weer online bent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 휴대폰에 있어요. 다시 온라인이 되면 올라가요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它先留在你的手机上，联网后就会上传。"
          }
        }
      }
    },
