# Local dev values match docker-compose.dev.yml
MONGODB_URI=mongodb://127.0.0.1:27027/pluck?replicaSet=rs0&directConnection=true
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production-0123456789
EMAIL_FROM=Pluck <hello@getpluck.io>
# Set SMTP_URL to send through SMTP (Mailpit locally). Unset, email goes through SES with the default AWS credentials.
SMTP_URL=smtp://127.0.0.1:1035
AWS_REGION=eu-west-1
# Blobs: MinIO from docker-compose.dev.yml. In prod, unset S3_ENDPOINT and use the CDK bucket and IAM user.
S3_BUCKET=pluck-content
S3_ENDPOINT=http://127.0.0.1:9010
AWS_ACCESS_KEY_ID=pluck
AWS_SECRET_ACCESS_KEY=pluck-dev-secret
# Dev and e2e only: lets the server fetch the local fixture server. Never set in prod.
ALLOW_PRIVATE_FETCH=1
CRON_SECRET=dev-cron-secret
