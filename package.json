{
  "name": "pluck",
  "description": "Pluck: a fast, open-source URL saver with an MCP connector for the AI tool you already use.",
  "repository": { "type": "git", "url": "https://github.com/codu-code/pluck.git" },
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pluck/web dev",
    "stack": "docker compose -f docker-compose.dev.yml up -d --wait mongo mailpit minio fixtures && docker compose -f docker-compose.dev.yml run --rm minio-init",
    "stack:down": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "design": "node scripts/design-check.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@pluck/blob": "workspace:*",
    "@pluck/db": "workspace:*",
    "@pluck/i18n": "workspace:*",
    "@types/node": "^22",
    "eslint": "10.13.0",
    "impeccable": "4.7.0",
    "typescript": "^5.9",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
